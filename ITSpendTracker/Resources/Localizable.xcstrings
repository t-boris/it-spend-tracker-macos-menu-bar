        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в Cline"
          }
        }
      }
    },
    "Sign in to Cline again…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в Cline снова…"
          }
        }
      }
    },
    "Sign in with Cline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти через Cline"
          }
        }
      }
    },
    "Sign in with Cline and connect": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти через Cline и подключить"
          }
        }
      }
    },
    "Since %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С %@"
          }
        }
      }
    },
    "Since %@ · next payment %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Since %1$@ · next payment %2$@: %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С %1$@ · следующий платёж %2$@: %3$@"
          }
        }
      }
    },
    "Spend": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты"
          }
        }
      }
    },
    "Spend increased": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты выросли"
          }
        }
      }
    },
    "Spend is the Cline credits used plus Cline Pass payments. Credit top-ups and the balance come from Cline and are for information only.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты — это использованные кредиты Cline плюс платежи за Cline Pass. Пополнения кредитов и баланс загружаются из Cline и показаны для информации."
          }
        }
      }
    },
    "Spend is up: %@ vs %@ in the same days of last month": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Spend is up: %1$@ vs %2$@ in the same days of last month"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты выросли: %1$@ против %2$@ за те же дни прошлого месяца"
          }
        }
      }
    },
    "Spend per day": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходы по дням"
          }
        }
      }
